# Salin file ini menjadi .env.local lalu isi dengan kredensial project Supabase kamu
# Diperoleh dari: Supabase Dashboard > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opsional: dipakai backend/server action untuk operasi admin (JANGAN taruh di frontend)
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opsional (Sprint 4 — Spatial Map): tile layer dari Google Earth Engine.
# Dapatkan urlTemplate lewat ee.Image(...).getMapId() di Python API, lalu ambil
# nilai tile_fetcher.url_format-nya. Bisa isi sampai 4 layer (LAYER_1..LAYER_4).
# Kalau tidak diisi, Spatial Map tetap jalan tanpa overlay GEE.
NEXT_PUBLIC_GEE_LAYER_1_LABEL=Land Cover
NEXT_PUBLIC_GEE_LAYER_1_URL=https://earthengine.googleapis.com/v1/projects/EE_PROJECT/maps/MAP_ID/tiles/{z}/{x}/{y}
NEXT_PUBLIC_GEE_LAYER_2_LABEL=NDVI
NEXT_PUBLIC_GEE_LAYER_2_URL=
